# Brando - AI Brand Identity Studio

## Environment Variables
# Copy this file to .env.local and fill in the values

# Supabase Configuration (required for auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Logo Generation (optional - enables AI-powered logo generation)
# Supports any OpenAI-compatible API (OpenAI, Qwen, etc.)
QWEN_API_KEY=your-api-key-here
QWEN_BASE_URL=https://api.openai.com/v1
QWEN_MODEL=gpt-4

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
